<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded into every SCF executable when building with MSVC (see
  scf_configure_target in CMakeLists.txt).  On Windows 10 1903 and later this
  makes the process' active code page UTF-8, so command-line arguments and
  std::filesystem::path <-> std::string conversions round-trip non-ASCII text
  exactly like they do on Linux.  Older Windows versions ignore the setting.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
